{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "writer",
  "version": "0.1.0",
  "identifier": "com.writer.transparent-notepad",
  "mainBinaryName": "writer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "writer",
        "width": 520,
        "height": 520,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "azilier",
    "shortDescription": "自定义记事本",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
